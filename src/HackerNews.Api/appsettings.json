{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HackerNewsClient": {
    "BaseAddress": "https://hacker-news.firebaseio.com/v0/"
  },
  "StoriesCache": {
    "RefreshIntervalSeconds": 30,
    "MaxCachedStories": 200,
    "MaxDegreeOfParallelism": 20
  }
}
